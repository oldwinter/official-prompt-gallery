# Local MiniMax-H3 SGLang endpoint (defaults to http://127.0.0.1:30010).
H3_API_BASE=http://127.0.0.1:30010

# Private Sub2API route. Keep real values in the process environment or an
# approved secret store; never commit them and never pass them as CLI flags.
GROK_BASE_URL=https://sub2api.example.internal
GROK_API_KEY=

# Optional bounded polling controls for capture.mjs.
CAPTURE_POLL_LIMIT=30
CAPTURE_POLL_DELAY_MS=1000
